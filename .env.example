# Env for the monitoring stack.
# Separate from the app's own .env.
# docker compose loads it automatically when run from this directory.

# Grafana admin - change before exposing.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Loki push endpoint for Alloy.
# (Set on app host!)
#   Same host:                 leave empty -> http://loki:3100/loki/api/v1/push
#   Separate monitoring host:  http://<monitoring-host>:3100/loki/api/v1/push
LOKI_ENDPOINT=
